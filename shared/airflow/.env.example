# Airflow admin login
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow admin login web
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=password
_AIRFLOW_WWW_USER_FIRSTNAME=Admin
_AIRFLOW_WWW_USER_LASTNAME=User
_AIRFLOW_WWW_USER_EMAIL=email


# Airflow Postgres
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme

# Secrets
# Fernet key encrypts connection passwords/variables stored in Airflow's DB.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

AIRFLOW_FERNET_KEY=key

# API server's Flask session secret.
#   openssl rand -hex 32
AIRFLOW_API_SECRET_KEY=key

# Shared secret the scheduler/dag-processor use to authenticate to the
# api-server's internal execution API.
#   openssl rand -hex 32
AIRFLOW_JWT_SECRET=key


# Misc
AIRFLOW_UID=uid
AIRFLOW_WEB_PORT=port